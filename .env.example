# Local testing only. Submissions remain in the local process and are not delivered.
DOP_LOCAL_TEST=1

# Approved HTTPS intake endpoint. It must implement Idempotency-Key and return
# a 2xx JSON response with {"accepted": true} only after durable lead acceptance.
DOP_LEAD_WEBHOOK_URL=
DOP_LEAD_WEBHOOK_TOKEN=
DOP_RECEIPT_SECRET=

# Use the approved HTTPS origin and enable indexing only at release.
DOP_SITE_URL=
DOP_ALLOW_INDEXING=false

# Set the approved GTM container before building. External tags are off by default.
# Bind GA4, Google Ads, Meta and Clarity in the authorised container.
NEXT_PUBLIC_DOP_GTM_ID=
